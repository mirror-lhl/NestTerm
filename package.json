{
  "name": "nestterm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NestTerm - 跨平台 SSH/SFTP 运维客户端（Tauri 2 + Vue 3 + Rust）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
