    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:build:mac-arm64": "tauri build --target aarch64-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "element-plus": "^2.14.7",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
